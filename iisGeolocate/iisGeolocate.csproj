<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net472;net10.0</TargetFrameworks>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
        <AssemblyTitle>iisGeolocate</AssemblyTitle>
        <Company>Eric R. Zimmerman 501-313-3778</Company>
        <Product>iisGeolocate</Product>
        <Description>Add geolocation information to IIS logs</Description>
        <Copyright>Eric Zimmerman</Copyright>
        <LangVersion>10</LangVersion>
        <Version>2026.10.0</Version>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationIcon>GlobeInfo.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.13" />
    </ItemGroup>
    <ItemGroup>
        <None Include="SampleIISLog.log" />
    </ItemGroup>
    <ItemGroup>
        <Content Include="GlobeInfo.ico" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Costura.Fody" Version="6.2.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CsvHelper" Version="33.1.0" />
        <PackageReference Include="Exceptionless" Version="6.2.0" />
        <PackageReference Include="Fody" Version="6.9.3">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="MaxMind.GeoIP2" Version="6.1.0" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    </ItemGroup>
</Project>
